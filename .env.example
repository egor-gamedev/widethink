# Copy to .env (never commit it) and export the variables in your shell.
# widethink itself never reads .env files; the provider SDKs read these
# variables from the environment.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Point the OpenAI-compatible provider at a local server (vLLM, Ollama, ...):
# OPENAI_BASE_URL=http://localhost:8000/v1

# Opt in to tests that call real APIs (they cost money):
# WIDETHINK_LIVE_TESTS=1
