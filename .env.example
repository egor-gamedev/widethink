# Copy to .env in the project directory and fill in the keys you have. .env is
# git-ignored: never commit it. The `widethink` command line loads .env from the
# current directory (variables already set in the environment win); the Python
# library itself never reads it - the provider SDKs read the environment.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Point the OpenAI-compatible provider at a local server (vLLM, Ollama, ...):
# OPENAI_BASE_URL=http://localhost:8000/v1

# Opt in to tests that call real APIs (they cost money):
# WIDETHINK_LIVE_TESTS=1
